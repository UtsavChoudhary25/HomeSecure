<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HomeSecure" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_indigo_dark</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="android:statusBarColor">@color/bg_dark</item>

        <!-- Use dark background across app -->
